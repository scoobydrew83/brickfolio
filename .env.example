# Copy to .env (docker compose) or .env.local (npm run dev) and fill in. Everything is optional except
# what your chosen setup needs.

# --- BrickLink API (prices, images, piece counts) ---
# Create these at https://www.bricklink.com/v2/api/register_consumer.page (needs a BrickLink account).
# Register the access token for IP 0.0.0.0 unless your server has a fixed public IP.
# (BRICKLINK_TOKEN_VALUE, the name the n8n workflows used, also works.)
BRICKLINK_CONSUMER_KEY=
BRICKLINK_CONSUMER_SECRET=
BRICKLINK_TOKEN=
BRICKLINK_TOKEN_SECRET=

# --- Rebrickable API (optional: themes and minifigure counts; no prices) ---
# Free key from https://rebrickable.com/users/profile/ → Settings → API. Filled in during the daily sync. Also maps the
# part and colour numbers of imported Rebrickable CSVs (loose parts, your own builds) to BrickLink ones, and adds MOCs by number.
REBRICKABLE_API_KEY=
# Pages of Rebrickable's parts catalog (1,000 parts each) mapped to BrickLink and LDraw numbers per sync; a full pass
# is about 60 pages and is redone every 30 days. Default 20; 0 turns the part and colour ID map off.
# REBRICKABLE_ID_PAGES_PER_SYNC=20
# Rebrickable's free daily catalog downloads (with the key above): full = themes, sets, parts, colours, LEGO element IDs
# and set inventories (about 70 MB in the database; the default on Docker), owned = themes, colours and only the sets you
# own, want or have alternate builds of (the default, and the most, on Cloudflare D1), off. Each file is fetched at most
# once a day, only when Rebrickable published a new copy.
# REBRICKABLE_CATALOG=full
# Parts lists from Rebrickable (in BrickLink numbers), saving one BrickLink call per set; BrickLink's list is used when
# Rebrickable doesn't know a set or more than REBRICKABLE_PARTS_MAX_UNMAPPED percent of its lots have no BrickLink match.
# REBRICKABLE_PARTS=on
# REBRICKABLE_PARTS_MAX_UNMAPPED=2
# REBRICKABLE_CATALOG_URL=https://cdn.rebrickable.com/media/downloads   # a mirror, if you keep one

# --- Brickset API (optional: original retail prices and retirement dates; no sold prices) ---
# Free key from brickset.com → your account → API. Filled in during the daily sync.
BRICKSET_API_KEY=

# --- Barcode scanning (optional lookup services) ---
# Scan → the UPC/EAN on a box finds the set. Without these, the scanner knows barcodes you've confirmed and those the
# Brickset sync saves for sets you own or want; a new box needs its set number typed once. Only the barcode is sent.
# CompareTheBricks: free key at https://comparethebricks.com/en-us/api-access/ (250 lookups a day on the free tier).
COMPARETHEBRICKS_API_KEY=
# BrickEconomy (needs a Premium subscription). Unverified: written without its API reference and never tested with a
# real key, so it may not work.
BRICKECONOMY_API_KEY=
# BARCODE_PROVIDERS=comparethebricks,brickeconomy   # order to ask them in
# BARCODE_PROVIDER_TIMEOUT_MS=5000                   # per lookup
# BARCODE_SCANNING=off                               # hide the Scan page
# The shared, reviewed community list of barcodes and minifigure box codes (CC0), downloaded in the daily sync.
# COMMUNITY_LIST=off
# COMMUNITY_LIST_URL=https://raw.githubusercontent.com/scoobydrew83/brickfolio/main/lib/barcode/data/community.json
# Where the browser loads the OCR files for "Read the set number" (default: this server, or jsDelivr on Cloudflare).
# OCR_ASSETS_URL=https://files.example/ocr

# --- Alerts (optional) ---
# A message when a wishlist set's average sold price drops under your target, sent after each sync, and when a sync
# fails or finishes with problems. Set any number of channels; each alert goes to all of them.
# ntfy (phone push, e.g. https://ntfy.sh/your-secret-topic), a Discord webhook URL, or any URL that accepts JSON (n8n, Home Assistant).
ALERT_WEBHOOK_URL=
# ALERT_WEBHOOK_FORMAT=ntfy        # ntfy | discord | json; detected from the URL when unset
# ALERT_EMAIL_TO=you@example.com   # comma-separated; needs EMAIL_PROVIDER and EMAIL_FROM (below)
# ALERT_TELEGRAM_BOT_TOKEN=        # from @BotFather
# ALERT_TELEGRAM_CHAT_ID=
# ALERT_PUSHOVER_TOKEN=            # the application's API token
# ALERT_PUSHOVER_USER=             # your user key
# ALERT_GOTIFY_URL=https://gotify.example
# ALERT_GOTIFY_TOKEN=              # an application token
# SYNC_ALERT=off                   # no alert when a sync fails or finishes with problems
# APP_URL=https://bricks.example   # your Brickfolio address, so alerts link back to the wishlist
# SHARE_BASE_URL=https://brickfolio.tail1234.ts.net:8443   # public address for share links (default: APP_URL)
# And when a wishlist set's average sold price moves this many percent, up or down, since the last swing alert. 0 = off.
# PRICE_SWING_PCT=10
# The same channels warn once when a wishlist set will retire within this many days (Brickset dates). 0 = off.
# RETIRE_ALERT_DAYS=60
# Retailer offers posted to POST /api/v1/prices count for wishlist alerts this many days (default 3).
# OFFER_MAX_AGE_DAYS=3
# And for Designer Program projects you watch: this many days before the pre-order opens (and 3 days before it closes). 0 = off.
# DESIGNER_ALERT_DAYS=7

# --- Email (optional: password reset and email verification for Better Auth sign-in, #90) ---
# EMAIL_PROVIDER: smtp | resend | ses | postmark | cloudflare. Nothing is sent until it and EMAIL_FROM are set.
# EMAIL_PROVIDER=resend
# EMAIL_FROM=Brickfolio <noreply@bricks.example>   # an address your provider has verified
# smtp (Docker and other Node hosts; not Cloudflare Workers). SMTP_SECURE=true for implicit TLS (port 465);
# otherwise STARTTLS when the server offers it. SMTP_PORT defaults to 465 with SMTP_SECURE, else 587.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_SECURE=false
# resend: API key from resend.com → API Keys (sending access is enough).
# RESEND_API_KEY=
# postmark: the Server API token (server → API Tokens). POSTMARK_MESSAGE_STREAM defaults to "outbound".
# POSTMARK_SERVER_TOKEN=
# ses: Amazon SES v2. An IAM key allowed ses:SendEmail; AWS_SESSION_TOKEN for temporary keys.
# AWS_SES_REGION=eu-west-1
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SES_CONFIGURATION_SET=
# cloudflare: Cloudflare Email Service (beta, Workers Paid). From any host, the REST API with an API token allowed
# Email Sending: Edit. On Workers, leave these empty to use the send_email binding instead (EMAIL_BINDING, default EMAIL).
# CLOUDFLARE_ACCOUNT_ID=
# CLOUDFLARE_EMAIL_API_TOKEN=

# --- Part-out value (optional) ---
# Most BrickLink part prices the daily sync fetches (each is one call; prices are kept 30 days). It never uses
# more than what's left of BrickLink's 5,000 calls a day after the rest of the sync, minus 500. 0 = off.
# PARTOUT_DAILY_CALLS=1500
# The other condition's price guide per set (new vs. used gap), 1 call each, about weekly. Default: sets ÷ 7 + 10,
# up to 1,000. 0 turns it off.
# OTHER_GUIDE_DAILY_CALLS=

# --- Image cache ---
# Set and minifigure photos for share pages and offline scanning are kept on the server after first use. Docker keeps
# them in /data/images (in the data volume, safe to delete); without IMAGE_CACHE_DIR they go in an `images` folder
# next to the database (DATABASE_PATH), so `npm run dev` uses ./data/images. Cloudflare uses the
# IMAGE_CACHE R2 binding instead (see docs/cloudflare.md). IMAGE_CACHE=off passes photos through without keeping them.
# IMAGE_CACHE=off
# IMAGE_CACHE_DIR=/data/images
# IMAGE_CACHE_WARM=200          # photos the daily sync fetches ahead of time (0 = none)

# --- 3D model view (optional) ---
# The LDraw parts library the 3D view loads parts from: the official library (complete.zip from
# https://library.ldraw.org) unzipped, with parts/, p/ and LDConfig.ldr inside. Docker: mount it, e.g. ./ldraw:/ldraw.
LDRAW_LIBRARY_DIR=
# Docker and Coolify default to /data/ldraw: use Settings → Download the LDraw library to fill it.
# LDRAW_LIBRARY_ZIP_URL=https://library.ldraw.org/library/updates/complete.zip   # where that button downloads from
# Or a URL serving the same files (e.g. a bucket); used on Cloudflare, which has no file system.
# LDRAW_LIBRARY_URL=https://ldraw.example/library/
# The daily sync fetches set models from LDraw's Official Model Repository when a library is set. Turn that off with:
# LDRAW_OMR_SYNC=off

# --- Access control: none | tailscale | cloudflare-access | better-auth ---
# The compose overlays set this for you. Use "none" only when the app is reachable from this machine alone.
AUTH_MODE=none
# Optional: comma-separated Tailscale logins / Access emails allowed in. Empty = anyone the proxy lets through.
ALLOWED_USERS=
# Optional: the admins (comma-separated). Empty = everyone allowed in is an admin, as before. Once set, everyone else
# sees only the collections an admin (or the collection's owner) gives them a role in: Settings → People.
ADMIN_USERS=

# --- Better Auth sign-in (AUTH_MODE=better-auth): Brickfolio's own email + password accounts ---
# The first account to sign up is an admin; sign-up is then closed. ADMIN_USERS still adds admins.
BETTER_AUTH_SECRET=           # long random string, e.g. from: openssl rand -hex 32 (keep it: changing it signs everyone out)
BETTER_AUTH_URL=              # the address people use, e.g. https://brickfolio.example.com
# BETTER_AUTH_OPEN_SIGNUP=1   # let anyone create an account (they start with no collections). Otherwise only the
                              # emails in ALLOWED_USERS may sign up. Either way sign-up needs email (EMAIL_PROVIDER)
                              # so people can confirm their address; without it, an admin adds people in Settings → People.
# Sign in with Google / GitHub / Apple: each is on when both its keys are set. Redirect URI to register with the
# provider: <BETTER_AUTH_URL>/api/auth/callback/google (or /github, /apple). A provider-verified address counts as
# confirmed, so these need no EMAIL_PROVIDER; sign-up still follows ALLOWED_USERS / BETTER_AUTH_OPEN_SIGNUP.
# GOOGLE_CLIENT_ID=           # Google Cloud console → APIs & Services → Credentials → OAuth client ID (Web application)
# GOOGLE_CLIENT_SECRET=
# GITHUB_CLIENT_ID=           # GitHub → Settings → Developer settings → OAuth Apps → New OAuth App
# GITHUB_CLIENT_SECRET=
# APPLE_CLIENT_ID=            # the Services ID (e.g. com.example.brickfolio.web)
# APPLE_CLIENT_SECRET=        # the client-secret JWT signed with your Sign in with Apple key (expires within 6 months)
# APPLE_APP_BUNDLE_IDENTIFIER= # only for sign-in from a native iOS app
# With EMAIL_PROVIDER set, the sign-in page also offers "Email me a sign-in link".

# --- Cloudflare Access (AUTH_MODE=cloudflare-access) ---
CF_ACCESS_TEAM_DOMAIN=        # e.g. myteam.cloudflareaccess.com
CF_ACCESS_AUD=                # Application Audience (AUD) tag from the Access application
CLOUDFLARE_TUNNEL_TOKEN=      # only for compose.cloudflared.yml

# --- Tailscale (compose.tailscale.yml) ---
TS_AUTHKEY=                   # reusable, not ephemeral, tagged with TS_TAG (or an OAuth client secret)
TS_HOSTNAME=brickfolio        # served at https://<TS_HOSTNAME>.<your-tailnet>.ts.net
TS_TAG=tag:brickfolio

# --- Pick the overlay (docker compose reads this) ---
# COMPOSE_FILE=docker-compose.yml:compose.tailscale.yml
# COMPOSE_FILE=docker-compose.yml:compose.cloudflared.yml

# --- Scheduling and backups (self-hosted) ---
TZ=UTC                        # dates in history and the sync hour use this time zone
SYNC_HOUR=4                   # daily BrickLink sync at this local hour (0–23), or "off"
# Settings shows the running version and checks GitHub's public releases list once a day for a newer one.
# Nothing about your collection is sent. Turn it off with:
# UPDATE_CHECK=off
BACKUP_KEEP=7                 # daily database backups to keep in /data/backups (0 = none)

# --- Database on hosts without a disk (Vercel, Render free; docs/hosting.md) ---
# A libSQL URL here is used instead of the SQLite file (DATABASE_PATH): Turso (libsql://…) or a local file (file:…).
# DATABASE_URL=libsql://brickfolio-you.turso.io
# DATABASE_AUTH_TOKEN=
# Migrations run when the app opens the database; DB_MIGRATE=off skips that (on Vercel they run at build time by
# default, `npm run db:migrate`, and only for Production builds unless DB_MIGRATE_ON_BUILD=on).
# DB_MIGRATE=off
# DB_MIGRATE_ON_BUILD=on

# --- Other ---
# CRON_SECRET=                # lets an external scheduler call POST /api/v1/sync, or GET /api/v1/sync/cron (Vercel
                              # Cron, Render cron jobs), with "Authorization: Bearer <secret>"
# SYNC_TIME_LIMIT=180         # seconds after which a sync stops starting new work (oldest sets first); default 180
                              # on Vercel (its 300 s function limit), none elsewhere. off = none
# PORT=3000                   # host port for the default (localhost-only) setup
# BRICKFOLIO_IMAGE=ghcr.io/scoobydrew83/brickfolio:latest
# DEMO_MODE=on               # public read-only demo: sample data, all changes and outside services off (use with AUTH_MODE=none)

# --- MCP (optional) ---
# Let assistants connected to /api/mcp add sets and copies, change or remove copies and change the wishlist (docs/api.md).
# MCP_WRITE=on
