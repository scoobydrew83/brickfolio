# Copy to .env (docker compose) or .env.local (npm run dev) and fill in. Everything is optional except
# what your chosen setup needs.

# --- BrickLink API (prices, images, piece counts) ---
# Create these at https://www.bricklink.com/v2/api/register_consumer.page (needs a BrickLink account).
# Register the access token for IP 0.0.0.0 unless your server has a fixed public IP.
# (BRICKLINK_TOKEN_VALUE, the name the n8n workflows used, also works.)
BRICKLINK_CONSUMER_KEY=
BRICKLINK_CONSUMER_SECRET=
BRICKLINK_TOKEN=
BRICKLINK_TOKEN_SECRET=

# --- Rebrickable API (optional: themes and minifigure counts; no prices) ---
# Free key from https://rebrickable.com/users/profile/ → Settings → API. Filled in during the daily sync.
REBRICKABLE_API_KEY=
# Pages of Rebrickable's parts catalog (1,000 parts each) mapped to BrickLink and LDraw numbers per sync; a full pass
# is about 60 pages and is redone every 30 days. Default 20; 0 turns the part and colour ID map off.
# REBRICKABLE_ID_PAGES_PER_SYNC=20

# --- Brickset API (optional: original retail prices and retirement dates; no sold prices) ---
# Free key from brickset.com → your account → API. Filled in during the daily sync.
BRICKSET_API_KEY=

# --- Barcode scanning (optional lookup services) ---
# Scan → the UPC/EAN on a box finds the set. Without these, the scanner knows barcodes you've confirmed and those the
# Brickset sync saves for sets you own or want; a new box needs its set number typed once. Only the barcode is sent.
# CompareTheBricks: free key at https://comparethebricks.com/en-us/api-access/ (250 lookups a day on the free tier).
COMPARETHEBRICKS_API_KEY=
# BrickEconomy (paid API). Its barcode search isn't publicly documented; this follows its reference as described in issue #27.
BRICKECONOMY_API_KEY=
# BARCODE_PROVIDERS=comparethebricks,brickeconomy   # order to ask them in
# BARCODE_PROVIDER_TIMEOUT_MS=5000                   # per lookup
# BARCODE_SCANNING=off                               # hide the Scan page
# The shared, reviewed community list of barcodes and minifigure box codes (CC0), downloaded in the daily sync.
# COMMUNITY_LIST=off
# COMMUNITY_LIST_URL=https://raw.githubusercontent.com/scoobydrew83/brickfolio/main/lib/barcode/data/community.json
# Where the browser loads the OCR files for "Read the set number" (default: this server, or jsDelivr on Cloudflare).
# OCR_ASSETS_URL=https://files.example/ocr

# --- Wishlist alerts (optional) ---
# A message when a wishlist set's average sold price drops under your target, sent after each sync.
# ntfy (phone push, e.g. https://ntfy.sh/your-secret-topic), a Discord webhook URL, or any URL that accepts JSON.
ALERT_WEBHOOK_URL=
# ALERT_WEBHOOK_FORMAT=ntfy        # ntfy | discord | json; detected from the URL when unset
# APP_URL=https://bricks.example   # your Brickfolio address, so alerts link back to the wishlist
# SHARE_BASE_URL=https://brickfolio.tail1234.ts.net:8443   # public address for share links (default: APP_URL)
# The same webhook warns once when a wishlist set will retire within this many days (Brickset dates). 0 = off.
# RETIRE_ALERT_DAYS=60
# And for Designer Program projects you watch: this many days before the pre-order opens (and 3 days before it closes). 0 = off.
# DESIGNER_ALERT_DAYS=7

# --- Part-out value (optional) ---
# Most BrickLink part prices the daily sync fetches (each is one call; prices are kept 30 days). It never uses
# more than what's left of BrickLink's 5,000 calls a day after the rest of the sync, minus 500. 0 = off.
# PARTOUT_DAILY_CALLS=1500

# --- 3D model view (optional) ---
# The LDraw parts library the 3D view loads parts from: the official library (complete.zip from
# https://library.ldraw.org) unzipped, with parts/, p/ and LDConfig.ldr inside. Docker: mount it, e.g. ./ldraw:/ldraw.
LDRAW_LIBRARY_DIR=
# Docker and Coolify default to /data/ldraw: use Settings → Download the LDraw library to fill it.
# LDRAW_LIBRARY_ZIP_URL=https://library.ldraw.org/library/updates/complete.zip   # where that button downloads from
# Or a URL serving the same files (e.g. a bucket); used on Cloudflare, which has no file system.
# LDRAW_LIBRARY_URL=https://ldraw.example/library/
# The daily sync fetches set models from LDraw's Official Model Repository when a library is set. Turn that off with:
# LDRAW_OMR_SYNC=off

# --- Access control: none | tailscale | cloudflare-access ---
# The compose overlays set this for you. Use "none" only when the app is reachable from this machine alone.
AUTH_MODE=none
# Optional: comma-separated Tailscale logins / Access emails allowed in. Empty = anyone the proxy lets through.
ALLOWED_USERS=

# --- Cloudflare Access (AUTH_MODE=cloudflare-access) ---
CF_ACCESS_TEAM_DOMAIN=        # e.g. myteam.cloudflareaccess.com
CF_ACCESS_AUD=                # Application Audience (AUD) tag from the Access application
CLOUDFLARE_TUNNEL_TOKEN=      # only for compose.cloudflared.yml

# --- Tailscale (compose.tailscale.yml) ---
TS_AUTHKEY=                   # reusable, not ephemeral, tagged with TS_TAG (or an OAuth client secret)
TS_HOSTNAME=brickfolio        # served at https://<TS_HOSTNAME>.<your-tailnet>.ts.net
TS_TAG=tag:brickfolio

# --- Pick the overlay (docker compose reads this) ---
# COMPOSE_FILE=docker-compose.yml:compose.tailscale.yml
# COMPOSE_FILE=docker-compose.yml:compose.cloudflared.yml

# --- Scheduling and backups (self-hosted) ---
TZ=UTC                        # dates in history and the sync hour use this time zone
SYNC_HOUR=4                   # daily BrickLink sync at this local hour (0–23), or "off"
BACKUP_KEEP=7                 # daily database backups to keep in /data/backups (0 = none)

# --- Other ---
# CRON_SECRET=                # lets an external scheduler call POST /api/v1/sync with "Authorization: Bearer <secret>"
# PORT=3000                   # host port for the default (localhost-only) setup
# BRICKFOLIO_IMAGE=ghcr.io/scoobydrew83/brickfolio:latest
# DEMO_MODE=on               # public read-only demo: sample data, all changes and outside services off (use with AUTH_MODE=none)
